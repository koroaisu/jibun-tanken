{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jibun-tanken-api",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "AI_ENABLED": "false",
    "ALLOWED_ORIGINS": "http://localhost:8000",
    "GEMINI_MODEL": ""
  },
  "durable_objects": {
    "bindings": [{ "name": "USAGE", "class_name": "UsageLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UsageLimiter"] }]
}
